# 可选初始配置；也可直接在“模型与提示词设置”填写。界面保存的配置优先，无需重启。
# 不提交 .env。无密钥时显示真实错误，不自动生成替代成果。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=90000
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.2
LLM_MAX_INPUT_CHARS=115000
LLM_RATE_LIMIT=10
FILE_PARSE_RATE_LIMIT=30

# 仅监听本机
HOST=127.0.0.1
PORT=3000

# 留空使用项目 data/；不得置于 public/
# DATA_DIR=
# 默认自动选择当前系统的项目虚拟环境；仅需自定义解释器时配置本机路径
# PYTHON_BIN=
ASR_MODEL=./data/models/whisper-small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_THREADS=4
ASR_CHUNK_SECONDS=180
ASR_TASK_TIMEOUT_MS=7200000
AUDIO_MAX_BYTES=536870912
AUDIO_MAX_SECONDS=10800

# 生成互动的后端运行检查使用本机 Chrome
PREVIEW_BROWSER=chrome
# FFMPEG_PATH=  # 默认使用 imageio-ffmpeg 随依赖提供的可执行文件
