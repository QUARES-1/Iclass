# 可选初始配置；也可直接在“模型与提示词设置”填写。界面保存的配置优先，无需重启。
# 不提交 .env。无密钥时显示真实错误，不自动生成替代成果。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=90000
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.2
LLM_MAX_INPUT_CHARS=115000
LLM_RATE_LIMIT=10
FILE_PARSE_RATE_LIMIT=30

# 问卷连接也可在设置页填写；与文本模型凭据独立，留空可使用本地导入
JINSHUJU_ACCESS_TOKEN=
JINSHUJU_BASE_URL=https://jinshuju.net/api/v1
# 所有问卷请求共用队列，创建优先；请求起始间隔（0～60000毫秒）
FEEDBACK_API_INTERVAL_MS=1000
# JSON 上传上限最多5 MiB，记录总数最多50000，文本最多20000字符
FEEDBACK_MAX_IMPORT_BYTES=4194304
FEEDBACK_MAX_RECORDS=10000
FEEDBACK_MAX_TEXT=4000
FEEDBACK_MAX_QUESTIONS=80
FEEDBACK_MAX_OPTIONS=80

# 仅监听本机
HOST=127.0.0.1
PORT=3000

# 留空使用项目 data/；不得置于 public/
# DATA_DIR=
# 业务数据额度（包含录音、恢复副本和归档；不包含模型权重），默认5 GiB
DATA_MAX_BYTES=5368709120
# 默认自动选择当前系统的项目虚拟环境；仅需自定义解释器时配置本机路径
# PYTHON_BIN=
ASR_MODEL=./data/models/whisper-small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_THREADS=4
ASR_CHUNK_SECONDS=180
ASR_TASK_TIMEOUT_MS=7200000
AUDIO_MAX_BYTES=536870912
AUDIO_MAX_SECONDS=10800

# 生成互动的后端运行检查使用本机 Chrome
PREVIEW_BROWSER=chrome
# FFMPEG_PATH=  # 默认使用 imageio-ffmpeg 随依赖提供的可执行文件
