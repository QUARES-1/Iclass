# 复制为 .env 后填写真实值。不要提交 .env。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=45000
LLM_RATE_LIMIT=10
FILE_PARSE_RATE_LIMIT=30

# Whisper 语音转写（Sprint 2）
WHISPER_MODEL=small
# 国内首次下载 Whisper 模型建议走 HuggingFace 镜像
HF_ENDPOINT=https://hf-mirror.com

# 默认只监听本机，避免在局域网中暴露使用 API Key 的接口。
HOST=127.0.0.1
PORT=3000